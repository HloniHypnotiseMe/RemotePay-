# Provider secrets are injected at runtime. Do not commit real credentials.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# RemotePay merchant API authentication.
# JSON mapping of API key to merchant ID.
REMOTEPAY_API_KEYS_JSON=
CHECKOUT_BASE_URL=https://api.remote-pay.co.za
PAYMENT_PROVIDER=payfast

# API Configuration
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,https://www.remote-pay.co.za

# Database
DATABASE_URL=
